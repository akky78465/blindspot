{
  "name": "maryada",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm start -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm test -w backend",
    "sample": "node --import tsx scripts/sample.ts",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.0",
    "@playwright/test": "latest"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}