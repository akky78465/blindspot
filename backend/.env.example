ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Edge-case review. Claude (CLAUDE_MODEL) generates the cases. Leave OPENAI_API_KEY empty to keep upload and mapping working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Features analyzed in parallel during edge-case generation (lower it if you hit rate limits)
EDGE_CONCURRENCY=4
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
# Comma-separated keys for Swagger and direct API calls. Leave empty to disable the check.
BLINDSPOT_API_KEYS=
