ANTHROPIC_API_KEY=
# Strong model: edge analysis and escalation. Fallback for LLM_EDGES / LLM_ESCALATE.
CLAUDE_MODEL=claude-sonnet-5-5
# Fast model for normalize and feature mapping (must support forced tool use)
LLM_NORMALIZE=claude-haiku-5-5
LLM_MAP=claude-haiku-5-5
LLM_EDGES=claude-sonnet-5-5
LLM_ESCALATE=claude-sonnet-5-5
# Features analyzed in parallel during edge-case generation (lower it if you hit rate limits)
EDGE_CONCURRENCY=4
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
