ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Edge-case review. Claude (CLAUDE_MODEL) generates the cases. Leave OPENAI_API_KEY empty to keep upload and mapping working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Local cost traces. Requires a Phoenix process on port 6006. Leave unset on Render.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=blindspot
# Features analyzed in parallel during edge-case generation (lower it if you hit rate limits)
EDGE_CONCURRENCY=4
PORT=3000
FRONTEND_ORIGIN=http://localhost:4300
# Comma-separated keys for Swagger and direct API calls. Leave empty to disable the check.
BLINDSPOT_API_KEYS=
TESTRAIL_URL=https://example.testrail.com
Testrail_Username=
Testrail_Password=
